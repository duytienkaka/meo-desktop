#!/bin/sh
# Allow bootstrap of an empty remote, then prevent accidental direct main pushes.
while read -r local_ref local_oid remote_ref remote_oid
do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$remote_oid" != "0000000000000000000000000000000000000000" ]; then
    echo "Main is shared. Push a feature branch and open a Pull Request instead." >&2
    exit 1
  fi
done
exit 0
